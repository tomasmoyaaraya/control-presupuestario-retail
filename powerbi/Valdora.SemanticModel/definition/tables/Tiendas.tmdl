table Tiendas

	column tienda_id
		dataType: string
		summarizeBy: none
		sourceColumn: tienda_id

	column tienda
		dataType: string
		summarizeBy: none
		sourceColumn: tienda

	column comuna
		dataType: string
		summarizeBy: none
		sourceColumn: comuna

	column zona
		dataType: string
		summarizeBy: none
		sourceColumn: zona

	column formato
		dataType: string
		summarizeBy: none
		sourceColumn: formato

	column apertura
		dataType: dateTime
		formatString: dd-mm-yyyy
		summarizeBy: none
		sourceColumn: apertura

	column dotacion
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: dotacion

	column arriendo_uf
		dataType: double
		formatString: #,0
		summarizeBy: none
		sourceColumn: arriendo_uf

	partition Tiendas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "\tiendas.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"tienda_id", type text}, {"tienda", type text}, {"comuna", type text}, {"zona", type text}, {"formato", type text}, {"apertura", type date}, {"dotacion", Int64.Type}, {"arriendo_uf", type number}}, "en-US")
				in
				    Tipos

