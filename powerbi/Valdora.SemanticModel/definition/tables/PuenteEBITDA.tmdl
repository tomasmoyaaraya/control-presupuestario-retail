table PuenteEBITDA

	column Concepto
		dataType: string
		sortByColumn: orden
		summarizeBy: none
		sourceColumn: Concepto

	column 'MM$'
		dataType: double
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: MM$

	column orden
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: orden

	partition PuenteEBITDA = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(CarpetaDatos & "\powerbi\puente_ebitda.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"Concepto", type text}, {"MM$", type number}, {"orden", Int64.Type}}, "en-US")
				in
				    Tipos

