table Calendario
	dataCategory: Time

	column Fecha
		dataType: dateTime
		formatString: dd-mm-yyyy
		summarizeBy: none
		sourceColumn: Fecha

	column Año
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Año

	column Mes
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Mes

	column MesNombre
		dataType: string
		sortByColumn: Mes
		summarizeBy: none
		sourceColumn: MesNombre

	column AñoMes
		dataType: string
		summarizeBy: none
		sourceColumn: AñoMes

	column PeriodoOrden
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: PeriodoOrden

	column Periodo
		dataType: string
		sortByColumn: PeriodoOrden
		summarizeBy: none
		sourceColumn: Periodo

	partition Calendario = m
		mode: import
		source =
				let
				    Inicio = #date(2024, 1, 1),
				    Fin = #date(2026, 12, 31),
				    Fechas = List.Dates(Inicio, Duration.Days(Fin - Inicio) + 1, #duration(1, 0, 0, 0)),
				    Tabla = Table.FromList(Fechas, Splitter.SplitByNothing(), {"Fecha"}),
				    Tipada = Table.TransformColumnTypes(Tabla, {{"Fecha", type date}}),
				    ConAño = Table.AddColumn(Tipada, "Año", each Date.Year([Fecha]), Int64.Type),
				    ConMes = Table.AddColumn(ConAño, "Mes", each Date.Month([Fecha]), Int64.Type),
				    ConNombre = Table.AddColumn(ConMes, "MesNombre", each Text.Start(Date.MonthName([Fecha], "es-CL"), 3), type text),
				    ConAñoMes = Table.AddColumn(ConNombre, "AñoMes", each Date.ToText([Fecha], "yyyy-MM"), type text),
				    ConOrden = Table.AddColumn(ConAñoMes, "PeriodoOrden", each Date.Year([Fecha]) * 100 + Date.Month([Fecha]), Int64.Type),
				    ConPeriodo = Table.AddColumn(ConOrden, "Periodo", each [MesNombre] & " " & Text.End(Text.From(Date.Year([Fecha])), 2), type text)
				in
				    ConPeriodo

