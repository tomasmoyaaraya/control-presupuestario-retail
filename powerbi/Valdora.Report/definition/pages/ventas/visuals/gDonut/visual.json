{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/1.0.0/schema.json",
  "name": "gDonut",
  "position": {
    "x": 860,
    "y": 190,
    "z": 0,
    "width": 400,
    "height": 260
  },
  "visual": {
    "visualType": "donutChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Categorias"
                    }
                  },
                  "Property": "categoria"
                }
              },
              "queryRef": "Categorias.categoria",
              "nativeQueryRef": "categoria"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Medidas"
                    }
                  },
                  "Property": "Venta YTD (MM$)"
                }
              },
              "queryRef": "Medidas.Venta YTD (MM$)",
              "nativeQueryRef": "Venta YTD (MM$)"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Venta año a la fecha por categoría (MM$)'"
                }
              }
            }
          }
        }
      ]
    },
    "objects": {
      "labels": [
        {
          "properties": {
            "labelStyle": {
              "expr": {
                "Literal": {
                  "Value": "'Percent of total'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "9D"
                }
              }
            }
          }
        }
      ],
      "legend": [
        {
          "properties": {
            "position": {
              "expr": {
                "Literal": {
                  "Value": "'Right'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "9D"
                }
              }
            }
          }
        }
      ]
    }
  }
}